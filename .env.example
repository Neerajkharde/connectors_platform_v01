# SAP S/4HANA Connection
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=
SAP_USERNAME=
SAP_PASSWORD=
# Auth mode: "apikey" (APIKey header - REQUIRED for the SAP API Business Hub sandbox),
#            "basic"  (HTTP Basic, for on-premise / BTP systems) or "none".
SAP_AUTH_MODE=apikey

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sap_connector
PG_USER=postgres
PG_PASSWORD=postgres

# Extraction limits (max records per run)
SUPPLIER_TOP=800
PO_TOP=5000
ITEM_TOP=20000
INVOICE_TOP=5000

# Request behaviour - keeps the connector inside the sandbox quota
SAP_PAGE_SIZE=50          # records per HTTP page
SAP_FILTER_CHUNK=20       # keys combined into one $filter (A or B or C ...)
SAP_USE_EXPAND=true       # fetch supplier company/purch-org/text with $expand
SAP_REQUEST_DELAY=0.25    # minimum seconds between SAP calls (0 to disable)
SAP_MAX_RETRIES=3         # retries for temporary errors (spike arrest, 503, ...)
SAP_TIMEOUT=60            # seconds before a SAP call is abandoned
