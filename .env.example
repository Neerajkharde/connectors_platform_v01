# SAP S/4HANA Connection
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=
SAP_USERNAME=
SAP_PASSWORD=
# Auth mode: "none" (no auth, for sandbox), "apikey" (APIKey header), or "basic" (HTTP Basic)
SAP_AUTH_MODE=none

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sap_connector
PG_USER=postgres
PG_PASSWORD=postgres

# Extraction Settings
SUPPLIER_TOP=800
PO_TOP=5000
INVOICE_TOP=5000
